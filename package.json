{
  "name": "dchat",
  "version": "1.6.1",
  "description": "Chit-Chat - dental office communication board",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "server": "node server.js",
    "dist": "electron-builder",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win"
  },
  "keywords": [],
  "author": "Your Name",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "electron": "^43.1.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.dental.chitchat",
    "productName": "Chit-Chat",
    "files": [
      "main.js",
      "server.js",
      "paths.js",
      "discovery.js",
      "preload.js",
      "notify-preload.js",
      "setup.html",
      "index.html",
      "supplies.html",
      "package.json"
    ],
    "asarUnpack": [
      "*.html"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64",
            "x64"
          ]
        }
      ],
      "category": "public.app-category.medical",
      "identity": null
    }
  },
  "productName": "Chit-Chat"
}
